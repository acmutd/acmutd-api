# ---------------------------------------------------------------------------
# The frontend .env is only used when running npm run dev (Vite dev server)
# When running through the Go server (go run ./cmd/api/main.go), the
# backend injects the config directly into the HTML via the 
# __FIREBASE_CONFIG__ replacement in dashboard_pages.go, so the
# frontend .env is not needed in production
# ---------------------------------------------------------------------------

# Firebase Config
VITE_FIREBASE_API_KEY = your-api-key
VITE_FIREBASE_AUTH_DOMAIN = your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID = your-project-id