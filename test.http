// THIS FILE TESTS THE API ENDPOINTS (USES THE VSCODE EXTENSION "REST CLIENT" TO TEST THE API)
// UPDATE THE API KEYS TO THE ONES GENERATED BY THE API (API-KEY IN .ENV FILE)

// for local testing
// @baseUrl = http://localhost:8080
// for testing on prod
@baseUrl = https://api.acmutd.co
@apiKey = {{$dotenv API_KEY}}

### ============================================
### HEALTH CHECK (No Auth Required)
### ============================================

### Health Check
GET {{baseUrl}}/health

### ============================================
### TERMS ENDPOINTS
### ============================================

### Get All Terms
GET {{baseUrl}}/api/v1/terms/
X-API-Key: {{apiKey}}

### Get All Terms (page 2)
GET {{baseUrl}}/api/v1/terms/?page=2&limit=10
X-API-Key: {{apiKey}}

### ============================================
### GENERAL COURSE ENDPOINTS
### ============================================

### Get General Courses by Prefix (CS)
GET {{baseUrl}}/api/v1/courses/general?prefix=cs
X-API-Key: {{apiKey}}

### Get General Courses by Prefix and Number (CS 1337)
GET {{baseUrl}}/api/v1/courses/general?prefix=cs&number=1337
X-API-Key: {{apiKey}}

### Get General Courses by Prefix (MATH)
GET {{baseUrl}}/api/v1/courses/general?prefix=math
X-API-Key: {{apiKey}}

### Search General Courses by Query (Data Structures)
GET {{baseUrl}}/api/v1/courses/general?prefix=cs&q=Data Structures
X-API-Key: {{apiKey}}

### Get General Course by Path (CS 1337)
GET {{baseUrl}}/api/v1/courses/general/cs/1337
X-API-Key: {{apiKey}}

### Get General Course by Path (MATH 2413)
GET {{baseUrl}}/api/v1/courses/general/math/2413
X-API-Key: {{apiKey}}

### ============================================
### SECTION ENDPOINTS
### ============================================

### Get Sections by Term (Spring 2025)
GET {{baseUrl}}/api/v1/courses/sections?term=25s
X-API-Key: {{apiKey}}

### Get Sections by Term and Prefix (CS, Spring 2025)
GET {{baseUrl}}/api/v1/courses/sections?term=25s&prefix=cs
X-API-Key: {{apiKey}}

### Get Sections by Term, Prefix, and Number (CS 1337, Spring 2025)
GET {{baseUrl}}/api/v1/courses/sections?term=25s&prefix=cs&number=1337
X-API-Key: {{apiKey}}

### Get Sections by Term and Instructor
GET {{baseUrl}}/api/v1/courses/sections?term=25s&instructor=john doe
X-API-Key: {{apiKey}}

### Get Sections by Term and Day (Monday)
GET {{baseUrl}}/api/v1/courses/sections?term=25s&prefix=cs&days=monday
X-API-Key: {{apiKey}}

### Get Sections by Term and Building (ECSS)
GET {{baseUrl}}/api/v1/courses/sections?term=25s&prefix=cs&building=ecss
X-API-Key: {{apiKey}}

### Get Sections by Title Substring
GET {{baseUrl}}/api/v1/courses/sections?term=25s&prefix=cs&title=Data Structures
X-API-Key: {{apiKey}}

### Get Section by Full Address (CS 1337.001.25s)
GET {{baseUrl}}/api/v1/courses/sections/cs/1337/001/25s
X-API-Key: {{apiKey}}

### ============================================
### PROFESSOR ENDPOINTS
### ============================================

### Get Professor by ID
GET {{baseUrl}}/api/v1/professors/id/jws130830
X-API-Key: {{apiKey}}

### Search Professors by Name Prefix
GET {{baseUrl}}/api/v1/professors/name/john
X-API-Key: {{apiKey}}

### Search Professors by Full Name
GET {{baseUrl}}/api/v1/professors/name/anani komla adabrah
X-API-Key: {{apiKey}}
